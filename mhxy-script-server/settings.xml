<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- 项目专用本地仓库，与系统其他项目隔离 -->
    <localRepository>D:\Program Files\mhxy\mhxy-script-server\.m2\repository</localRepository>

    <!-- ============ 镜像配置 ============ -->
    <mirrors>
        <!-- central 不设镜像：org.openpnp:opencv 阿里云未同步，需直连 repo1.maven.org -->

        <!-- Spring 插件仓库也走阿里云 -->
        <mirror>
            <id>aliyun-spring</id>
            <name>阿里云 Spring 镜像</name>
            <url>https://maven.aliyun.com/repository/spring</url>
            <mirrorOf>spring-plugin,spring-milestones,spring-snapshots</mirrorOf>
        </mirror>

        <!-- 公共库走阿里云 -->
        <mirror>
            <id>aliyun-public</id>
            <name>阿里云公共仓库镜像</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>*,!central,!spring-plugin,!spring-milestones,!spring-snapshots</mirrorOf>
        </mirror>
    </mirrors>

    <!-- ============ Profile 配置 ============ -->
    <profiles>
        <!-- Spring Boot 3.2 / Java 17 编译环境 -->
        <profile>
            <id>mhxy-project</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>

            <properties>
                <maven.compiler.source>17</maven.compiler.source>
                <maven.compiler.target>17</maven.compiler.target>
                <maven.compiler.release>17</maven.compiler.release>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            </properties>

            <repositories>
                <!-- 阿里云公共仓库 -->
                <repository>
                    <id>aliyun-public</id>
                    <name>阿里云公共仓库</name>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>

                <!-- 阿里云 Spring 仓库 -->
                <repository>
                    <id>aliyun-spring</id>
                    <name>阿里云 Spring 仓库</name>
                    <url>https://maven.aliyun.com/repository/spring</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>

            <pluginRepositories>
                <!-- 阿里云插件仓库 -->
                <pluginRepository>
                    <id>aliyun-plugin</id>
                    <name>阿里云插件仓库</name>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </pluginRepository>

                <!-- Maven Central 插件（备用） -->
                <pluginRepository>
                    <id>central-plugin-backup</id>
                    <name>Maven Central 插件（备用）</name>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <!-- 激活本项目专用 Profile -->
    <activeProfiles>
        <activeProfile>mhxy-project</activeProfile>
    </activeProfiles>

</settings>
