    if isframeSame(curFrame, lastFrame, similar=0.98):
    isStopHuangDong = True
    logger.info(f"{deviceId}��ͼû�ζ���")
    break
    else:
    logger.info(f"{deviceId}��ͼ�ζ���")
    lastFrame = curFrame
